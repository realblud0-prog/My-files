return function(target, selectedName, activeTraps, LocalPlayer)
    local RunService = game:GetService("RunService")
    if not target or not target.Character then return end
    if activeTraps[target] then activeTraps[target]:Disconnect() end

    local remoteCache = {}
    local wsCom = workspace:FindFirstChild("WorkspaceCom")
    if wsCom then 
        for _, cat in pairs(wsCom:GetChildren()) do 
            for _, p in pairs(cat:GetChildren()) do 
                if p:FindFirstChild("SetCurrentCFrame") then table.insert(remoteCache, p) end 
            end 
        end 
    end

    if #remoteCache == 0 then return end
    selectedName.Text = "FLINGING: " .. target.Name; selectedName.TextColor3 = Color3.fromRGB(200, 80, 80)
    
    local currentIdx = 1

    activeTraps[target] = RunService.Heartbeat:Connect(function()
        if not target or not target.Character then return end
        local char = target.Character
        local tRoot = char:FindFirstChild("HumanoidRootPart")
        if not tRoot then return end

        local prop = remoteCache[currentIdx]
        if prop then
            local remote = prop:FindFirstChild("SetCurrentCFrame")
            
            -- FORCE UNANCHOR
            for _, part in ipairs(prop:GetDescendants()) do
                if part:IsA("BasePart") then 
                    part.Anchored = false 
                    pcall(function() part:SetNetworkOwner(LocalPlayer) end)
                end
            end

            -- EXACT QUANTUM MATH (+5000 Y Axis)
            local velocity = tRoot.AssemblyLinearVelocity
            local predictedPos = tRoot.CFrame + (velocity * 0.175) + Vector3.new(0, 5000, 0)

            local mIdx = ((currentIdx - 1) % 10) + 1
            local speed = tick() * 255
            
            local randomSpin = CFrame.Angles(
                math.sin(speed + (mIdx * 0.5)) * 5,
                math.cos(speed + (mIdx * 0.8)) * 5, 
                math.tan(speed + (mIdx * 0.2)) * 0.5
            )
            local fPos = predictedPos * randomSpin
            
            task.spawn(function() pcall(function() remote:InvokeServer(fPos) end) end)
        end
        currentIdx = (currentIdx % #remoteCache) + 1
    end)
end
