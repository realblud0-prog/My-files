return function(target, selectedName, activeTraps, LocalPlayer)
    local RunService = game:GetService("RunService")
    if not target or not target.Character then return end
    if activeTraps[target] then activeTraps[target]:Disconnect() end

    local remotes = {}
    local wsCom = workspace:FindFirstChild("WorkspaceCom")
    if wsCom then 
        for _, cat in pairs(wsCom:GetChildren()) do 
            for _, p in pairs(cat:GetChildren()) do 
                if p:FindFirstChild("SetCurrentCFrame") then table.insert(remotes, p.SetCurrentCFrame) end 
            end 
        end 
    end

    if #remotes == 0 then selectedName.Text = "No props found!"; selectedName.TextColor3 = Color3.fromRGB(200, 80, 80); return end

    selectedName.Text = "EXECUTING: " .. target.Name; selectedName.TextColor3 = Color3.fromRGB(200, 80, 80)
    local currentIdx = 1
    local NETWORK_TICK_RATE = 0.033
    local LAST_SEND_TIME = {}
    local NETWORK_STATE = {}

    local function fireMove(remote, pos)
        local t = tick()
        if t - (LAST_SEND_TIME[remote] or 0) >= NETWORK_TICK_RATE and not NETWORK_STATE[remote] then
            LAST_SEND_TIME[remote] = t; NETWORK_STATE[remote] = true
            task.spawn(function()
                local completed = false
                task.spawn(function() pcall(function() remote:InvokeServer(pos) end); completed = true; NETWORK_STATE[remote] = false end)
                task.delay(0.05, function() if not completed then NETWORK_STATE[remote] = false end end)
            end)
        end
    end

    activeTraps[target] = RunService.Heartbeat:Connect(function()
        if not target or not target.Character then return end
        local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
        local tHum = target.Character:FindFirstChildOfClass("Humanoid")
        if not tRoot or not tHum then return end

        local remote = remotes[currentIdx]
        if remote then
            local pos = tRoot.CFrame
            if tHum.Sit then
                pos = CFrame.new(tRoot.Position.X, -50000, tRoot.Position.Z)
            end
            fireMove(remote, pos)
        end
        currentIdx = (currentIdx % #remotes) + 1
    end)
end
